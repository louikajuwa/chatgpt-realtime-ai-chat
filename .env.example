# Copy to .env and edit. Never commit .env.

# --- OpenAI ---
# Required for live responses.
OPENAI_API_KEY=sk-your-key-here
# Model used with the Responses API.
OPENAI_MODEL=gpt-5-mini
# API base URL. Override only for mock testing (e.g. http://host.docker.internal:8089/v1).
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Redis ---
# Compose service name.
REDIS_HOST=redis
REDIS_PORT=6379
# Optional. If set, compose starts Redis with --requirepass and the app authenticates.
REDIS_PASSWORD=

# --- App ---
# In-container listen port (compose maps it to 127.0.0.1:3005).
PORT=3000
# Optional. When set, the browser must enter this token. SET THIS before exposing the app beyond localhost.
APP_ACCESS_TOKEN=
# Comma-separated allowed browser origins (e.g. https://chat.example.com). Empty = same-origin only.
ALLOWED_ORIGINS=
# Maximum concurrent Socket.IO connections.
MAX_CONNECTIONS=20
# Maximum length (characters) of the stored brain.
BRAIN_MAX_CHARS=20000
# Maximum number of recent messages sent to the model per request.
MAX_HISTORY_MESSAGES=40
# Maximum length (characters) of a single message.
MESSAGE_MAX_CHARS=8000
# Maximum length (characters) of per-chat instructions.
INSTRUCTIONS_MAX_CHARS=4000
